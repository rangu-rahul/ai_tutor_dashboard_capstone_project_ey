# ==============================================
# Django / Python AI Tutor Dashboard .gitignore
# ==============================================

# ── Environment & Secrets ──────────────────────
.env
.env.*
*.env
!.env.example

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ── Virtual Environment ─────────────────────────
venv/
env/
.venv/
ENV/

# ── Django ─────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# ── Machine Learning / AI ──────────────────────
*.pkl
*.h5
*.model
*.joblib
*.pt
*.pth
*.onnx

# ── Distribution / Packaging ───────────────────
dist/
build/
*.egg-info/
.eggs/
*.egg

# ── Testing & Coverage ─────────────────────────
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# ── IDEs & Editors ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
